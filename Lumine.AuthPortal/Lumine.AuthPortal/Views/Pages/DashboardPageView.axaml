<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumine.AuthPortal.ViewModels.Pages"
             x:Class="Lumine.AuthPortal.Views.Pages.DashboardPageView"
             x:DataType="vm:DashboardPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
        <Grid ColumnDefinitions="1.15*,0.85*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="系统总体信息" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}"/>
          </StackPanel>

          <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="520">
            <Border Margin="0,0,12,0" VerticalAlignment="Center" ToolTip.Tip="{Binding ServiceStatusAccessibilityText}">
              <Grid>
                <TextBlock Text="{Binding ServiceStatusText}" Foreground="{DynamicResource StatusInfoBrush}" IsVisible="{Binding IsServiceStatusLoading}"/>
                <TextBlock Text="{Binding ServiceStatusText}" Foreground="{DynamicResource StatusSuccessBrush}" IsVisible="{Binding IsServiceStatusHealthy}"/>
                <TextBlock Text="{Binding ServiceStatusText}" Foreground="{DynamicResource StatusWarningBrush}" IsVisible="{Binding IsServiceStatusWarning}"/>
                <TextBlock Text="{Binding ServiceStatusText}" Foreground="{DynamicResource StatusErrorBrush}" IsVisible="{Binding IsServiceStatusError}"/>
                <TextBlock Text="{Binding ServiceStatusText}" Foreground="{DynamicResource StatusInfoBrush}" IsVisible="{Binding IsServiceStatusRestricted}"/>
              </Grid>
            </Border>
            <Button Margin="0,0,12,0"
                    Classes="admin-button"
                    Background="{DynamicResource SurfaceSoftBrush}"
                    BorderBrush="{DynamicResource StatusWarningBrush}"
                    BorderThickness="1"
                    Padding="8,4"
                    Content="{Binding OperationalAttentionText}"
                    IsVisible="{Binding ShowOperationalAttention}"
                    Click="OnOperationalAttentionClick"
                    ToolTip.Tip="滚动到下方的运营提醒详情"
                    AutomationProperties.Name="查看运营提醒详情"/>
            <TextBlock Margin="0,0,12,0" Text="{Binding LastUpdatedText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LastUpdatedText}" IsVisible="{Binding ShowLastUpdated}"/>
            <Button Classes="admin-button"
                    Content="{Binding ConnectionDiagnosticsToggleText}"
                    Command="{Binding ToggleConnectionDiagnosticsCommand}"
                    IsVisible="{Binding ShowConnectionDiagnostics}"
                    ToolTip.Tip="{Binding ConnectionDiagnosticsToggleToolTip}"
                    AutomationProperties.Name="{Binding ConnectionDiagnosticsToggleToolTip}"/>
            <Button Classes="admin-button admin-primary"
                    Content="{Binding RefreshButtonText}"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding CanRefresh}"
                    ToolTip.Tip="刷新仪表盘数据"
                    AutomationProperties.Name="刷新仪表盘数据"/>
          </WrapPanel>

          <Border Grid.Row="1" Grid.ColumnSpan="2"
                  Background="{DynamicResource SurfaceSoftBrush}"
                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12"
                  IsVisible="{Binding ShowConnectionDiagnosticsArea}">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
              <TextBlock Text="服务地址" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding BackendBaseUrl}" Watermark="http://localhost:14255" MinWidth="240"/>
              <Button Grid.Column="2"
                      Content="应用并刷新"
                      Command="{Binding RefreshCommand}"
                      IsEnabled="{Binding CanRefresh}"
                      ToolTip.Tip="应用服务地址并刷新仪表盘"
                      AutomationProperties.Name="应用服务地址并刷新仪表盘"/>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding DiscoverySummary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding ServiceStatusAccessibilityText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14" IsVisible="{Binding ShowLoadingState}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="正在加载仪表盘数据…" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="首次加载可能需要几秒钟。" Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource StatusInfoBrush}" BorderThickness="1" CornerRadius="12" Padding="14" IsVisible="{Binding ShowLoadError}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding LoadErrorMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="重试" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"/>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding SummaryCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DashboardStatCardItemViewModel">
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1.5" CornerRadius="14" Margin="0,0,12,0" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding ValueText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Background="{DynamicResource SurfacePanelBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="20"
              IsVisible="{Binding HasOperationalSignals}"
              x:Name="OperationalSignalsPanel">
        <StackPanel Spacing="12">
          <TextBlock Text="运营提醒" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="{Binding OperationalSignalsHint}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding OperationalSignalItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemWidth="280" ItemHeight="122"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DashboardOperationalSignalItemViewModel">
                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource StatusWarningBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,12,0" Padding="12">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="6">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{DynamicResource StatusWarningBrush}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <Button Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Content="查看详情"
                            Command="{Binding OpenDetailsCommand}"
                            IsEnabled="{Binding CanOpenDetails}"
                            HorizontalAlignment="Right"
                            Classes="admin-row-button"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="登录趋势" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding LoginTrendHint}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="暂无数据" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding ShowLoginTrendEmptyState}"/>
            <ItemsControl ItemsSource="{Binding LoginTrendItems}" IsVisible="{Binding HasLoginTrendData}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DashboardTrendBarItemViewModel">
                  <StackPanel Spacing="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding ValueText}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid Height="120" VerticalAlignment="Bottom">
                      <Border Width="28" Height="{Binding BarHeight}" Background="{Binding BarBrush}" CornerRadius="10,10,4,4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="Token 签发趋势" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding TokenTrendHint}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="暂无数据" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding ShowTokenTrendEmptyState}"/>
            <ItemsControl ItemsSource="{Binding TokenTrendItems}" IsVisible="{Binding HasTokenTrendData}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DashboardTrendBarItemViewModel">
                  <StackPanel Spacing="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding ValueText}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid Height="120" VerticalAlignment="Bottom">
                      <Border Width="28" Height="{Binding BarHeight}" Background="{Binding BarBrush}" CornerRadius="10,10,4,4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="1.2*,0.8*" ColumnSpacing="16">
        <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="最近登录用户" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding RecentLoginUsersHint}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="暂无最近登录用户" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding ShowRecentLoginUsersEmptyState}"/>
            <ItemsControl ItemsSource="{Binding RecentLoginUsers}" IsVisible="{Binding HasRecentLoginUsers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentLoginUserItemViewModel">
                  <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource SurfaceSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AvatarText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding UserName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Email}" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ClientName}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding LoginTimeText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Text="OIDC Discovery" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding DiscoverySummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
