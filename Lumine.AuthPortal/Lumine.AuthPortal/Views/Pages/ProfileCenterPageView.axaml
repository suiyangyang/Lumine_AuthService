<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumine.AuthPortal.ViewModels.Pages"
             xmlns:model="using:Lumine.AuthPortal.Models"
             x:Class="Lumine.AuthPortal.Views.Pages.ProfileCenterPageView"
             x:DataType="vm:ProfileCenterPageViewModel">
  <UserControl.Styles>
    <Style Selector="TextBox.profile-password-input">
      <Setter Property="Padding" Value="12,8,44,8"/>
    </Style>
    <Style Selector="Button.password-visibility-button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource LoginMutedBrush}"/>
    </Style>
    <Style Selector="Button.password-visibility-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource LoginInputHoverBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LoginPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.password-visibility-button:pressed">
      <Setter Property="Background" Value="{DynamicResource LoginSelectionBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LoginPrimaryPressedBrush}"/>
    </Style>
    <Style Selector="PathIcon.password-visibility-icon">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
    </Style>
    <Style Selector="Button.api-key-row-icon-button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.api-key-row-icon-button:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.api-key-row-icon-button:pressed">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.api-key-row-icon-button:disabled">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="Button.api-key-row-icon-button.api-key-delete">
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftForegroundBrush}"/>
    </Style>
    <Style Selector="Button.api-key-row-icon-button.api-key-delete:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftHoverForegroundBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
            <TextBlock Text="{Binding DisplayName}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextOnAccentBrush}"
                       FontSize="18"
                       FontWeight="Bold"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding LoginStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusInfoBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="资料编辑" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Text="用户名" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="请输入用户名"/>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="邮箱" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="请输入邮箱"/>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="昵称" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox Text="{Binding NickName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="选填"/>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="手机号" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="选填"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="刷新资料"
                    Classes="admin-button"
                    Command="{Binding LoadCommand}"
                    Padding="14,8"/>
            <Button Content="保存资料"
                    Classes="admin-button admin-primary"
                    Command="{Binding SaveCommand}"
                    Padding="14,8"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="API-KEY 接口管理" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="生成 API-KEY" Classes="admin-button admin-primary" Command="{Binding CreateApiKeyCommand}" Padding="14,8" IsEnabled="{Binding !IsBusy}"/>
          </Grid>

          <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="14" IsVisible="{Binding HasApiKeys}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                <TextBlock Text="KEY值" Classes="admin-hint"/>
                <TextBlock Grid.Column="1" Text="最近使用" Classes="admin-hint"/>
                <TextBlock Grid.Column="2" Text="操作" Classes="admin-hint"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding ApiKeys}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="model:ApiKeyDto">
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,2">
                      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding MaskedKeyDisplay}"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastUsedTimeDisplay}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                          <Button Classes="api-key-row-icon-button"
                                  Click="OnCopyApiKeyItemClick"
                                  IsEnabled="{Binding CanCopy}"
                                  ToolTip.Tip="复制 API-KEY">
                            <PathIcon Data="{Binding $parent[UserControl].DataContext.ApiKeyCopyIconData}" Classes="admin-row-button-icon"/>
                          </Button>
                          <Button Classes="api-key-row-icon-button api-key-delete"
                                  Command="{Binding $parent[UserControl].DataContext.RequestDeleteApiKeyCommand}"
                                  CommandParameter="{Binding .}"
                                  IsVisible="{Binding !IsRevoked}"
                                  ToolTip.Tip="删除 API-KEY">
                            <PathIcon Data="{Binding $parent[UserControl].DataContext.ApiKeyDeleteIconData}" Classes="admin-row-button-icon"/>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <TextBlock Text="暂未生成 API-KEY。生成后可在列表中随时复制完整 key，并不要写入代码仓库、截图或公开聊天。"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasApiKeys}"/>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="角色与权限" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="角色标签" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <ItemsControl ItemsSource="{Binding RoleTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource RoleTagBackgroundBrush}" CornerRadius="999" Padding="12,6" Margin="0,0,8,8">
                  <TextBlock Text="{Binding .}" Foreground="{DynamicResource RoleTagForegroundBrush}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="权限摘要" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="14">
            <TextBlock Text="{Binding PermissionSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="修改密码" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="修改后，下一次登录请使用新密码。" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Text="当前密码" Foreground="{DynamicResource TextMutedBrush}"/>
                <Grid>
                  <TextBox Text="{Binding CurrentPassword}"
                           Classes="profile-password-input"
                           PasswordChar="{Binding CurrentPasswordMaskChar}"
                           Watermark="请输入当前密码"/>
                  <Button Classes="password-visibility-button"
                          Command="{Binding ToggleCurrentPasswordVisibilityCommand}"
                          ToolTip.Tip="{Binding CurrentPasswordVisibilityToolTip}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0">
                    <PathIcon Data="{Binding CurrentPasswordVisibilityIconData}" Classes="password-visibility-icon"/>
                  </Button>
                </Grid>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="新密码" Foreground="{DynamicResource TextMutedBrush}"/>
                <Grid>
                  <TextBox Text="{Binding NewPassword}"
                           Classes="profile-password-input"
                           PasswordChar="{Binding NewPasswordMaskChar}"
                           Watermark="请输入新密码"/>
                  <Button Classes="password-visibility-button"
                          Command="{Binding ToggleNewPasswordVisibilityCommand}"
                          ToolTip.Tip="{Binding NewPasswordVisibilityToolTip}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0">
                    <PathIcon Data="{Binding NewPasswordVisibilityIconData}" Classes="password-visibility-icon"/>
                  </Button>
                </Grid>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="确认新密码" Foreground="{DynamicResource TextMutedBrush}"/>
                <Grid>
                  <TextBox Text="{Binding ConfirmNewPassword}"
                           Classes="profile-password-input"
                           PasswordChar="{Binding ConfirmNewPasswordMaskChar}"
                           Watermark="请再次输入新密码"/>
                  <Button Classes="password-visibility-button"
                          Command="{Binding ToggleConfirmNewPasswordVisibilityCommand}"
                          ToolTip.Tip="{Binding ConfirmNewPasswordVisibilityToolTip}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0">
                    <PathIcon Data="{Binding ConfirmNewPasswordVisibilityIconData}" Classes="password-visibility-icon"/>
                  </Button>
                </Grid>
              </StackPanel>
              <Button Content="立即修改密码"
                      HorizontalAlignment="Left"
                      Classes="admin-button admin-primary"
                      Command="{Binding ChangePasswordCommand}"
                      Padding="14,8"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

  </Grid>
</UserControl>
