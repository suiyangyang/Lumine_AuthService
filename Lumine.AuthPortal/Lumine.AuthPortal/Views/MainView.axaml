<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Lumine.AuthPortal.ViewModels"
             xmlns:controls="using:Lumine.AuthPortal.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
             x:Name="Root"
             x:Class="Lumine.AuthPortal.Views.MainView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Border.nav-section-container">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="0,14,0,0"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="Button.nav-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style Selector="Button.nav-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.nav-item:pressed">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.nav-item.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
    </Style>
    <Style Selector="Button.nav-item.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
    </Style>
    <Style Selector="Button.nav-item.selected:pressed">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedPressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveStrongBrush}"/>
    </Style>
    <Style Selector="Border.nav-section-children">
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TextBlock.nav-section-title">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="PathIcon.nav-section-icon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="PathIcon.nav-expand-icon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="PathIcon.nav-item-icon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.nav-item-label">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-section-toggle:pointerover PathIcon.nav-section-icon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-section-toggle:pointerover PathIcon.nav-expand-icon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-item:pointerover PathIcon.nav-item-icon">
      <Setter Property="Foreground" Value="{DynamicResource TextAccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.nav-item:pointerover TextBlock.nav-item-label">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-item.selected PathIcon.nav-item-icon">
      <Setter Property="Foreground" Value="{DynamicResource TextAccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.nav-item.selected TextBlock.nav-item-label">
      <Setter Property="Foreground" Value="{DynamicResource TextOnSelectedBrush}"/>
    </Style>
    <Style Selector="Button.nav-section-toggle">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style Selector="Button.nav-section-toggle:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-section-toggle:pressed">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="Button.account-trigger /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger /template/ Border#border">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger:pointerover /template/ Border#border">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger:pressed">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-trigger:pressed /template/ Border#border">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
    </Style>
    <Style Selector="Border.account-avatar">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
    </Style>
    <Style Selector="Border.account-menu">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="TextBlock.account-label">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.account-chip">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Button.account-menu-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.account-menu-item /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-item /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-item /template/ Border#border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.account-menu-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-item:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-item:pointerover /template/ Border#border">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-item:pressed">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-item:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-item:pressed /template/ Border#border">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-logout">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.account-menu-logout /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftForegroundBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-logout /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftForegroundBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-logout /template/ Border#border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.account-menu-logout:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftHoverForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.account-menu-logout:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftHoverForegroundBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-logout:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftHoverForegroundBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-logout:pointerover /template/ Border#border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.account-menu-logout:pressed">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftPressedForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.account-menu-logout:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftPressedForegroundBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-logout:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftPressedForegroundBrush}"/>
    </Style>
    <Style Selector="Button.account-menu-logout:pressed /template/ Border#border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.app-toast">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="RenderTransform">
        <Setter.Value>
          <TranslateTransform Y="-28"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Transitions">
        <Setter.Value>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"/>
          </Transitions>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="Border.app-toast.toast-visible">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="RenderTransform">
        <Setter.Value>
          <TranslateTransform Y="0"/>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="Border.app-toast.toast-success">
      <Setter Property="Background" Value="{DynamicResource SuccessBannerBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBannerBorderBrush}"/>
    </Style>
    <Style Selector="Border.app-toast.toast-error">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBorderBrush}"/>
    </Style>
    <Style Selector="TextBlock.app-toast-text">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Border.app-toast.toast-success TextBlock.app-toast-text">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBannerForegroundBrush}"/>
    </Style>
    <Style Selector="Border.app-toast.toast-error TextBlock.app-toast-text">
      <Setter Property="Foreground" Value="{DynamicResource DangerSoftForegroundBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid Background="{DynamicResource AppBackgroundBrush}">
    <Grid IsVisible="{Binding IsAnonymous}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
          <ContentControl Content="{Binding CurrentPage}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Grid>
      </ScrollViewer>
    </Grid>

    <Grid IsVisible="{Binding IsAuthenticated}"
          ColumnDefinitions="260,*"
          RowDefinitions="Auto,*">
      <Border Grid.RowSpan="2"
              Background="{DynamicResource SidebarBackgroundBrush}"
              Padding="20,20,16,20">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <controls:LumineBrandMark Width="44" Height="44"/>
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Lumine AuthPortal"
                         FontSize="20"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="统一身份认证后台"
                         Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
          </StackPanel>

          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding VisibleNavigationSections}"
                          HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationSectionViewModel">
                <Border Classes="nav-section-container">
                  <StackPanel Spacing="6">
                    <Button Classes="nav-section-toggle"
                            Command="{Binding ToggleSectionCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="18,*,16" ColumnSpacing="8" HorizontalAlignment="Stretch">
                        <PathIcon Grid.Column="0"
                                  Data="{Binding IconData}"
                                  Classes="nav-section-icon"
                                  Width="14"
                                  Height="14"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Classes="nav-section-title"
                                   VerticalAlignment="Center"/>
                        <PathIcon Grid.Column="2"
                                  Data="{Binding ExpandIconData}"
                                  Classes="nav-expand-icon"
                                  Width="13"
                                  Height="13"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                      </Grid>
                    </Button>

                    <Border Classes="nav-section-children"
                            ClipToBounds="True"
                            MaxHeight="{Binding ChildrenMaxHeight}"
                            Opacity="{Binding ChildrenOpacity}">
                      <Border.Transitions>
                        <Transitions>
                          <DoubleTransition Property="MaxHeight" Duration="0:0:0.18"/>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
                        </Transitions>
                      </Border.Transitions>
                      <ItemsControl ItemsSource="{Binding Items}"
                                    HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <Button Command="{Binding NavigateCommand, ElementName=Root}"
                                    CommandParameter="{Binding Key}"
                                    Classes="nav-item"
                                    Classes.selected="{Binding IsSelected}"
                                    IsVisible="{Binding IsVisible}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                              <Grid ColumnDefinitions="24,*" HorizontalAlignment="Stretch">
                                <PathIcon Grid.Column="0"
                                          Data="{Binding IconData}"
                                          Classes="nav-item-icon"
                                          Width="17"
                                          Height="17"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           Classes="nav-item-label"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource TopbarBackgroundBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              Padding="24,16">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding CurrentPageTitle}"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="10"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <Button x:Name="AccountMenuButton"
                    Classes="account-trigger"
                    Command="{Binding ToggleAccountMenuCommand}"
                    VerticalAlignment="Center">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Classes="account-avatar" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AccountInitial}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="Bold"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AccountDisplayName}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="{Binding AccountRolesSummary}"
                             Classes="account-label"
                             MaxWidth="240"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <PathIcon Grid.Column="2"
                          Data="{Binding AccountMenuChevronIconData}"
                          Width="14"
                          Height="14"
                          Foreground="{DynamicResource TextMutedBrush}"
                          VerticalAlignment="Center"/>
              </Grid>
            </Button>

            <Button Classes="account-trigger"
                    Command="{Binding ToggleThemeCommand}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding CurrentThemeLabel}">
              <PathIcon Data="{Binding ThemeToggleIconData}"
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>

            <Popup IsOpen="{Binding IsAccountMenuOpen}"
                   Placement="BottomEdgeAlignedRight"
                   PlacementTarget="{Binding #AccountMenuButton}"
                   HorizontalOffset="0"
                   VerticalOffset="10">
              <Border Classes="account-menu"
                      Width="280">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="account-avatar">
                      <TextBlock Text="{Binding AccountInitial}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 TextAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontWeight="Bold"/>
                    </Border>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding AccountDisplayName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="{Binding AccountStatusText}" Classes="account-label"/>
                    </StackPanel>
                  </StackPanel>

                  <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Padding="10">
                    <StackPanel Spacing="6">
                      <TextBlock Text="邮箱" Classes="account-label"/>
                      <TextBlock Text="{Binding AccountEmail}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding AccountRolesSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="4">
                    <Button Classes="account-menu-item"
                            Command="{Binding OpenProfileCenterCommand}"
                            Content="个人中心"/>
                    <Button Classes="account-menu-item"
                            Command="{Binding OpenSecuritySettingsCommand}"
                            Content="安全设置"/>
                  </StackPanel>

                  <Button Classes="account-menu-logout"
                          Content="退出登录"
                          Command="{Binding LogoutCommand}"
                          MinHeight="34"/>
                </StackPanel>
              </Border>
            </Popup>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Grid.Column="1"
              Padding="24"
              Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <ContentControl Content="{Binding CurrentPage}"/>
        </ScrollViewer>
      </Border>

      <Button Grid.ColumnSpan="2"
              Grid.RowSpan="2"
              Background="Transparent"
              BorderThickness="0"
              IsVisible="{Binding IsAccountMenuOpen}"
              Command="{Binding CloseAccountMenuCommand}"/>
    </Grid>

    <Grid IsVisible="{Binding IsAuthenticated}">
      <Border x:CompileBindings="False"
              DataContext="{Binding CurrentPage}"
              Classes="dialog-backdrop"
              IsVisible="{Binding IsApiKeyRevealDialogOpen}">
      <Grid>
        <Button Background="Transparent"
                BorderThickness="0"
                Command="{Binding CloseApiKeyRevealDialogCommand}"/>
        <Border Classes="dialog-card"
                Width="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
            <StackPanel Spacing="5">
              <TextBlock Text="API-KEY 已生成"
                         FontSize="22"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="请立即复制完整 API-KEY；关闭此窗口后将不再显示完整内容。"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"/>
            </StackPanel>
            <TextBox Grid.Row="1"
                     Text="{Binding NewlyGeneratedApiKey}"
                     IsReadOnly="True"
                     FontFamily="Consolas"/>
            <Border Grid.Row="2" Classes="admin-danger-banner" Padding="12">
              <TextBlock Text="API-KEY 等同于密码，请妥善保管，不要提交到代码仓库或发送给他人；如有泄露，请立即删除并重新生成。"
                         Foreground="{DynamicResource TextOnAccentBrush}"
                         TextWrapping="Wrap"/>
            </Border>
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right">
              <Button Content="复制 API-KEY"
                      Classes="admin-button admin-primary"
                      Tag="{Binding NewlyGeneratedApiKey}"
                      Click="OnCopyApiKeyClick"
                      Padding="14,8"/>
              <Button Content="我已妥善保存，关闭"
                      Classes="admin-button"
                      Command="{Binding CloseApiKeyRevealDialogCommand}"
                      Padding="14,8"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      </Border>

      <Border x:CompileBindings="False"
              DataContext="{Binding CurrentPage}"
              Classes="dialog-backdrop"
              IsVisible="{Binding IsApiKeyDeleteDialogOpen}">
      <Grid>
        <Button Background="Transparent"
                BorderThickness="0"
                Command="{Binding CancelDeleteApiKeyCommand}"/>
        <Border Classes="dialog-card"
                Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock Text="确认删除 API-KEY"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding ApiKeyDeleteConfirmationText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right">
              <Button Content="取消"
                      Classes="admin-button"
                      Command="{Binding CancelDeleteApiKeyCommand}"
                      Padding="14,8"/>
              <Button Content="确认删除"
                      Classes="admin-button admin-danger-solid"
                      Command="{Binding ConfirmDeleteApiKeyCommand}"
                      Padding="14,8"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
      </Border>
    </Grid>

    <Border Classes="dialog-backdrop" IsVisible="{Binding IsReLoginDialogOpen}">
      <Border Classes="dialog-card"
              Width="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="需要重新登录"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="密码已修改，当前登录令牌已失效。请重新登录后继续使用。"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap"/>
          <Button Content="重新登录"
                  Classes="admin-button admin-primary"
                  Command="{Binding ConfirmReLoginCommand}"
                  HorizontalAlignment="Right"
                  Padding="16,8"/>
        </StackPanel>
      </Border>
    </Border>

    <Border Classes="app-toast"
            Classes.toast-success="{Binding IsToastSuccess}"
            Classes.toast-error="{Binding IsToastError}"
            Classes.toast-visible="{Binding IsToastVisible}"
            IsHitTestVisible="{Binding IsToastVisible}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,24,0,0"
            ZIndex="200">
      <TextBlock Text="{Binding ToastMessage}"
                 Classes="app-toast-text"
                 TextWrapping="Wrap"
                 MaxWidth="360"/>
    </Border>
  </Grid>
</UserControl>
