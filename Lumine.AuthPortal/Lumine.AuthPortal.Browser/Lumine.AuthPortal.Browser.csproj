<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0-browser</TargetFramework>
		<OutputType>Exe</OutputType>
		<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>false</InvariantGlobalization>
		<BlazorIcuDataFileName>icudt_CJK.dat</BlazorIcuDataFileName>
		<PublishTrimmed>false</PublishTrimmed>
		<WasmBuildNative>true</WasmBuildNative>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Browser" />
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Lumine.AuthPortal\Lumine.AuthPortal.csproj" />
	</ItemGroup>

	<Target Name="CopyPackageStaticAssetsToOutput" AfterTargets="Build" DependsOnTargets="GetCurrentProjectBuildStaticWebAssetItems">
		<ItemGroup>
			<AvaloniaPackageStaticAssets Include="$(NuGetPackageRoot)avalonia.browser\*\staticwebassets\*.*"
								 Condition="Exists('$(NuGetPackageRoot)avalonia.browser')" />
			<HotReloadPackageStaticAssets Include="@(_CachedBuildStaticWebAssetItems)"
								  Condition="'%(_CachedBuildStaticWebAssetItems.AssetTraitName)' == 'JSModule' and '%(_CachedBuildStaticWebAssetItems.AssetTraitValue)' == 'JSLibraryModule' and '%(_CachedBuildStaticWebAssetItems.AssetRole)' == 'Primary'" />
		</ItemGroup>

		<Copy SourceFiles="@(AvaloniaPackageStaticAssets)"
			  DestinationFolder="$(OutputPath)wwwroot\_framework"
			  SkipUnchangedFiles="true"
			  Condition="'@(AvaloniaPackageStaticAssets)' != ''" />

		<Copy SourceFiles="@(HotReloadPackageStaticAssets)"
			  DestinationFiles="@(HotReloadPackageStaticAssets->'$(OutputPath)wwwroot\_framework\Microsoft.DotNet.HotReload.WebAssembly.Browser.%(Fingerprint).lib.module.js')"
			  SkipUnchangedFiles="true"
			  Condition="'@(HotReloadPackageStaticAssets)' != ''" />
	</Target>
</Project>
